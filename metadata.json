{
  "name": "icann-file_upload",
  "version": "0.1.2",
  "author": "john.bond@icann.org",
  "summary": "small modules to install file_upload and custom modules",
  "license": "MPL-2.0",
  "source": "https://github.com/icann-dns/puppet-file_upload",
  "project_page": "https://github.com/icann-dns/puppet-file_upload",
  "issues_url": "https://github.com/icann-dns/puppet-file_upload/issues",
  "dependencies": [
    { "name": "puppetlabs-stdlib", "version_requirement": ">= 2.0.0 <3.0.0" },
    { "name": "puppetlabs-cron_core", "version_requirement": ">= 8.0.0 <10.0.0" }
  ],
  "requirements": [
    {   
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }   
  ], 
  "operatingsystem_support": [
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "20.04"
      ]
    },
    {
      "operatingsystem": "FreeBSD",
      "operatingsystemrelease": [
        "10"
      ]
    }
  ]
}
